# ==============================================================================
# Service Flow — Environment Configuration
# ==============================================================================
# Service Flow operates in Demo Mode by default without requiring Supabase credentials.
# To connect your own live Supabase cloud instance, provide your project credentials below.

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser client execution)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Port (Vite default: 5173)
PORT=5173

